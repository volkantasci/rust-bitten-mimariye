# NewKindLearn Rust deney imajı. Taban: resmî Docker Hub "rust" imajı (Debian trixie).
# Nightly bir tarihe sabitlenmiştir (nightly-2026-11-20 = rustc 1.102.0-nightly 6905905bb, 2026-11-19);
# deney kayıtlarındaki Miri, sanitizer ve -Z çıktıları bu sürüme aittir. Komutlar `+nightly` ile çağırdığı
# için sabit sürüm "nightly" adıyla kurulur.
FROM docker.io/library/rust:1.100.0
ARG NIGHTLY=2026-11-20
RUN rustup component add clippy rustfmt \
 && HOST="$(rustc -vV | sed -n 's/^host: //p')" \
 && rustup toolchain install nightly-${NIGHTLY} --profile minimal --component miri,rust-src \
 && mv "$RUSTUP_HOME/toolchains/nightly-${NIGHTLY}-${HOST}" "$RUSTUP_HOME/toolchains/nightly-${HOST}" \
 && rm -f "$RUSTUP_HOME/update-hashes/nightly-${NIGHTLY}-${HOST}" \
 && rustc +nightly -V | grep -q '6905905bb' \
 && apt-get update \
 && apt-get install -y --no-install-recommends valgrind strace gdb hyperfine time \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /work
